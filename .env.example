# ==========================================
# Configuración del Bot Meep
# ==========================================

# Token del Bot de Discord (obtenido de https://discord.com/developers/applications)
DISCORD_TOKEN=tu_token_aqui

# Prefijo para comandos de texto (ejemplo: !c, !p, !queue)
BOT_PREFIX=!

# Clave de API de Riot Games (Opcional - para comandos de /live y /perfil)
# Obtenla gratis en: https://developer.riotgames.com/
RIOT_API_KEY=

# Servidor ID de Discord (Opcional - acelera el registro instantáneo de Slash commands si se especifica)
DEV_GUILD_ID=
